# =============================================================================
# Terraform
# =============================================================================
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Valores específicos do ambiente
*.tfvars
*.tfvars.json
backend.hcl
!*.tfvars.example
!backend.hcl.example

# Excecoes deliberadas, e nao descuido: os arquivos do ambiente dev sao
# versionados para a dupla trabalhar e gravar a demonstracao sem reconstruir
# configuracao a mao. Nenhum tem credencial — sao nome de bucket, regiao, nome
# do profile, tamanho de node e a lista de CIDRs autorizados no endpoint do EKS.
#
# As senhas continuam fora: sao geradas pelo Terraform, guardadas no Secrets
# Manager e entregues ao cluster pelo External Secrets. O que se versiona e o
# ExternalSecret, nunca o Secret.
#
# Qualquer .tfvars ou backend.hcl NOVO segue ignorado — as excecoes sao por
# caminho exato.
!terraform/envs/dev/infra/backend.hcl
!terraform/envs/dev/infra/terraform.tfvars
!terraform/envs/dev/platform/backend.hcl
!terraform/envs/dev/platform/terraform.tfvars

override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# =============================================================================
# Segredos e credenciais
# =============================================================================
.env
.env.local
.env.*.local
*.pem
*.key
!**/key.go
credentials

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
venv/
.venv/

# =============================================================================
# Go
# =============================================================================
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
!coverage.out.example

# =============================================================================
# Relatórios de segurança gerados localmente
# =============================================================================
*.sarif
bandit-report.json
sbom-*.json
checkov.sarif

# =============================================================================
# IDE e sistema operacional
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
